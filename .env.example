# Salin berkas ini menjadi .env. Jangan commit .env.

DATABASE_URL=postgresql://teduh:teduh@localhost:5432/teduh
DATABASE_SSL=false

# Minimal 32 karakter. Jangan pakai kalimat contoh ini di produksi.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

APP_URL=http://localhost:3000

# Midtrans. Placeholder + MIDTRANS_ALLOW_MOCK=true memakai pembayaran uji di localhost.
# Sandbox sungguhan: isi kunci dari dashboard Midtrans, set MIDTRANS_ALLOW_MOCK=false.
# Produksi: MIDTRANS_IS_PRODUCTION=true, MIDTRANS_ALLOW_MOCK=false, kunci produksi.
MIDTRANS_SERVER_KEY=SB-Mid-server-placeholder
MIDTRANS_CLIENT_KEY=SB-Mid-client-placeholder
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOW_MOCK=true

# Kosongkan untuk tarif perkiraan lokal. Isi kunci Biteship untuk tarif kurir sungguhan.
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com/v1
ORIGIN_POSTAL_CODE=12430

# Opsional. Jika kosong atau Redis mati, pembatas permintaan pakai memori proses.
REDIS_URL=

# Opsional. Jika tidak lengkap, unggahan admin disimpan di storage/uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

CRON_SECRET=
MIGRATE_ON_BOOT=false

SEED_ADMIN_EMAIL=admin@teduh.id
SEED_ADMIN_PASSWORD=teduh-admin
SEED_RESET_ADMIN=false

NEXT_PUBLIC_WHATSAPP_NUMBER=628111908800
NEXT_PUBLIC_STORE_EMAIL=halo@teduh.id
NEXT_PUBLIC_STORE_ADDRESS=Jl. Contoh Raya No. 8, Cilandak, Jakarta Selatan
NEXT_PUBLIC_STORE_LEGAL_NAME=Teduh

# Kosongkan untuk menonaktifkan. Butuh build ulang karena NEXT_PUBLIC dibaca saat build.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
